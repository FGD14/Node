<%- include('../partials/head', { title: 'Ficha de Aluno — IPCA Gestão', extraCss: ['ficha.css'] }) %>
<body>
<div class="wrapper">
    <%- include('../partials/sidebar', { active: 'ficha' }) %>
    <main class="main">
        <div class="page-header">
            <div class="page-title"><h1>Ficha de Aluno</h1><p>Preenche os teus dados e submete para validação</p></div>
            <% if (ficha) { %>
                <% const chips = {rascunho:'chip-amber',submetida:'chip-blue',aprovada:'chip-green',rejeitada:''}; %>
                <span class="chip <%= chips[ficha.estado] || '' %>" style="padding:8px 16px;font-size:0.85rem;">Estado: <%= ficha.estado %></span>
            <% } %>
        </div>
        <% if (msg === 'submetida') { %><div class="alert alert-success" style="margin-bottom:20px;">Ficha submetida! Aguarda validação.</div><% } %>
        <% if (msg === 'guardado') { %><div class="alert alert-success" style="margin-bottom:20px;">Rascunho guardado!</div><% } %>
        <% if (erro) { %><div class="alert alert-error" style="margin-bottom:20px;"><%= erro %></div><% } %>
        <% if (ficha && ficha.estado === 'rejeitada' && ficha.observacoes) { %>
            <div class="alert alert-error" style="margin-bottom:20px;"><strong>Ficha rejeitada:</strong> <%= ficha.observacoes %></div>
        <% } %>
        <% if (ficha && ficha.estado === 'aprovada') { %>
            <div class="alert alert-success" style="margin-bottom:20px;">✓ Ficha aprovada por <strong><%= ficha.validado_por %></strong></div>
        <% } %>

        <div class="card" style="max-width:700px;">
            <% const readonly = ficha && ['submetida','aprovada'].includes(ficha.estado) ? 'readonly' : ''; %>
            <% const disabled = ficha && ['submetida','aprovada'].includes(ficha.estado) ? 'disabled' : ''; %>
            <form method="POST" action="/aluno/ficha" enctype="multipart/form-data">
                <div style="display:flex;align-items:center;gap:20px;margin-bottom:28px;padding-bottom:24px;border-bottom:1px solid var(--border);">
                    <div style="width:90px;height:90px;border-radius:14px;overflow:hidden;background:var(--bg3);border:2px solid var(--border2);flex-shrink:0;">
                        <% if (ficha && ficha.foto) { %>
                            <img src="<%= ficha.foto %>" style="width:100%;height:100%;object-fit:cover;">
                        <% } else { %>
                            <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:var(--text3);">
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                            </div>
                        <% } %>
                    </div>
                    <div class="form-row" style="flex:1;margin-bottom:0;">
                        <label>Fotografia (JPG/PNG, máx. 2MB)</label>
                        <input type="file" name="foto" accept=".jpg,.jpeg,.png" <%= disabled %> style="padding:8px;cursor:pointer;">
                    </div>
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                    <div class="form-row" style="grid-column:1/-1;">
                        <label>Nome Completo *</label>
                        <input type="text" name="nome_completo" value="<%= ficha ? ficha.nome_completo || '' : '' %>" placeholder="Nome completo" required <%= readonly %>>
                    </div>
                    <div class="form-row">
                        <label>Data de Nascimento *</label>
                        <input type="date" name="data_nascimento" value="<%= ficha && ficha.data_nascimento ? new Date(ficha.data_nascimento).toISOString().split('T')[0] : '' %>" required <%= readonly %>>
                    </div>
                    <div class="form-row">
                        <label>Nacionalidade</label>
                        <input type="text" name="nacionalidade" value="<%= ficha ? ficha.nacionalidade || 'Portuguesa' : 'Portuguesa' %>" <%= readonly %>>
                    </div>
                    <div class="form-row">
                        <label>NIF *</label>
                        <input type="text" name="nif" value="<%= ficha ? ficha.nif || '' : '' %>" placeholder="000000000" maxlength="9" required <%= readonly %>>
                    </div>
                    <div class="form-row">
                        <label>Telefone</label>
                        <input type="text" name="telefone" value="<%= ficha ? ficha.telefone || '' : '' %>" placeholder="9XXXXXXXX" <%= readonly %>>
                    </div>
                    <div class="form-row" style="grid-column:1/-1;">
                        <label>Email *</label>
                        <input type="email" name="email" value="<%= ficha ? ficha.email || '' : '' %>" placeholder="email@exemplo.com" required <%= readonly %>>
                    </div>
                    <div class="form-row" style="grid-column:1/-1;">
                        <label>Morada</label>
                        <input type="text" name="morada" value="<%= ficha ? ficha.morada || '' : '' %>" placeholder="Rua, número, código postal" <%= readonly %>>
                    </div>
                    <div class="form-row" style="grid-column:1/-1;">
                        <label>Curso Pretendido *</label>
                        <select name="curso_pretendido" required <%= disabled %>>
                            <option value="">Seleciona um curso...</option>
                            <% cursos.forEach(c => { %>
                                <option value="<%= c._id %>" <%= ficha && ficha.curso_pretendido && ficha.curso_pretendido._id && ficha.curso_pretendido._id.toString() === c._id.toString() ? 'selected' : '' %>><%= c.nome %></option>
                            <% }) %>
                        </select>
                    </div>
                </div>
                <% if (!ficha || ['rascunho','rejeitada'].includes(ficha.estado)) { %>
                <div style="display:flex;gap:12px;margin-top:8px;">
                    <button type="submit" name="acao" value="rascunho" class="btn-submit" style="background:var(--surface2);flex:1;">Guardar Rascunho</button>
                    <button type="submit" name="acao" value="submeter" class="btn-submit" style="flex:2;" onclick="return confirm('Submeter a ficha? Não poderás editar depois.')">Submeter →</button>
                </div>
                <% } else if (ficha.estado === 'submetida') { %>
                    <div class="notice notice-blue" style="margin-top:16px;">A tua ficha aguarda validação do Gestor Pedagógico.</div>
                <% } %>
            </form>
        </div>
    </main>
</div>
</body>
</html>
