<%- include('../partials/head', { title: (curso ? 'Editar' : 'Novo') + ' Curso — IPCA Gestão', extraCss: ['form-gestor.css'] }) %>
<body>
<div class="wrapper">
    <%- include('../partials/sidebar', { active: 'cursos' }) %>
    <main class="main">
        <div class="page-header">
            <div class="page-title"><h1><%= curso ? 'Editar Curso' : 'Novo Curso' %></h1></div>
        </div>
        <div class="card form-card">
            <% if (erro) { %><div class="alert alert-error" style="margin-bottom:20px;"><%= erro %></div><% } %>
            <form method="POST" action="/gestor/cursos/<%= curso ? 'editar/' + curso._id : 'novo' %>">
                <div class="form-row">
                    <label>Nome do Curso</label>
                    <input type="text" name="nome" value="<%= curso ? curso.nome : '' %>" placeholder="Ex: Engenharia Informática" required>
                </div>
                <button type="submit" class="btn-submit"><%= curso ? 'Guardar Alterações' : 'Criar Curso' %></button>
                <a href="/gestor/cursos" class="btn-cancel-link">← Cancelar e Voltar</a>
            </form>
        </div>
    </main>
</div>
</body>
</html>
