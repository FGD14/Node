<%- include('../partials/head', { title: 'Pautas — IPCA Gestão', extraCss: ['pautas.css'] }) %>
<body>
<div class="wrapper">
    <%- include('../partials/sidebar', { active: 'pautas' }) %>
    <main class="main">
        <div class="page-header">
            <div class="page-title"><h1>Pautas de Avaliação</h1><p>Criar e gerir pautas</p></div>
        </div>
        <% if (msg === 'criada') { %><div class="alert alert-success" style="margin-bottom:20px;">Pauta criada!</div><% } %>
        <% if (msg === 'duplicada') { %><div class="alert alert-error" style="margin-bottom:20px;">Já existe uma pauta para esta UC, ano e época!</div><% } %>

        <div class="card" style="margin-bottom:20px;">
            <div class="section-header"><h3>Nova Pauta</h3></div>
            <form method="POST" action="/funcionario/pautas/nova">
                <div style="display:grid;grid-template-columns:2fr 1fr 1fr auto;gap:12px;align-items:end;">
                    <div class="form-row" style="margin-bottom:0;">
                        <label>Disciplina / UC</label>
                        <select name="disciplina_id" required>
                            <option value="">Seleciona...</option>
                            <% pautas.length >= 0 && [] %>
                        </select>
                    </div>
                    <div class="form-row" style="margin-bottom:0;">
                        <label>Ano Letivo</label>
                        <input type="text" name="ano_letivo" placeholder="2025/2026" value="2025/2026" required>
                    </div>
                    <div class="form-row" style="margin-bottom:0;">
                        <label>Época</label>
                        <select name="epoca">
                            <option>Normal</option>
                            <option>Recurso</option>
                            <option>Especial</option>
                        </select>
                    </div>
                    <button type="submit" class="btn-add" style="padding:12px 20px;">Criar</button>
                </div>
            </form>
        </div>

        <div class="card">
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Disciplina</th><th>Ano Letivo</th><th>Época</th><th>Criada por</th><th>Data</th><th>Ação</th></tr></thead>
                    <tbody>
                    <% if (pautas.length > 0) { %>
                        <% pautas.forEach(p => { %>
                        <tr>
                            <td><strong><%= p.disciplina_id?.nome || '—' %></strong></td>
                            <td><span class="chip chip-blue"><%= p.ano_letivo %></span></td>
                            <td><span class="chip chip-amber"><%= p.epoca %></span></td>
                            <td style="color:var(--text2);font-size:0.85rem;"><%= p.criado_por %></td>
                            <td style="color:var(--text2);font-size:0.85rem;"><%= new Date(p.data_criacao).toLocaleDateString('pt-PT') %></td>
                            <td><a href="/funcionario/pautas/<%= p._id %>" class="btn-edit">Ver / Notas</a></td>
                        </tr>
                        <% }) %>
                    <% } else { %>
                        <tr><td colspan="6"><div class="empty-state"><p>Nenhuma pauta encontrada.</p></div></td></tr>
                    <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</div>
</body>
</html>
